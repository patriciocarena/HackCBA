# Models route through OpenRouter. Both are required: the webhook route throws at boot
# without them, which is the point. There is no default model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Telegram. The bot token comes from BotFather; the secret is any long random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Admins, fail closed. Telegram user ids, comma separated. Unset, empty or unreadable
# denies everyone, so a deployment with no value here has no admin at all.
TELEGRAM_ADMIN_IDS=

# Where the LibSQL database lives. On Fly this is the mounted volume.
DATA_DIR=

# Transcription. All three are required: the port throws at boot without them.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
TRANSCRIPTION_LANGUAGE=es

# The alias a customer transfers the deposit to. Blank asks for a transfer into nothing,
# which requestDeposit refuses.
DEPOSIT_ALIAS=dante.imprenta.mp

# Where the owner reads that a receipt arrived. In a private chat this is their Telegram
# user id, the same number that goes in TELEGRAM_ADMIN_IDS. The notice names the order and
# sends them to the bank; it never carries the receipt.
OWNER_CHAT_ID=
