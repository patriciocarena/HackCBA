# Models route through OpenRouter. Both are required: the webhook route throws at boot
# without them, which is the point. There is no default model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Telegram. The bot token comes from BotFather; the secret is any long random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Admins, fail closed. Telegram user ids, comma separated. Unset, empty or unreadable
# denies everyone, so a deployment with no value here has no admin at all.
TELEGRAM_ADMIN_IDS=

# The secret the fence delimiter is an HMAC of. Every untrusted block handed to a model
# opens and closes with a nonce derived from it, so a customer who can compute the nonce can
# close our fence and open a fake answer block. Unset, fence.ts falls back to 32 random bytes
# per boot: unforgeable, but a new secret on every restart. Set, but left blank, is the worst
# of the three: the fallback is `??`, so an empty string is taken as the secret and every
# nonce becomes one anybody can derive. Fill it in or delete the line.
FENCE_SECRET=

# Where the LibSQL database lives. On Fly this is the mounted volume.
DATA_DIR=

# Transcription. All three are required: the port throws at boot without them.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
TRANSCRIPTION_LANGUAGE=es
