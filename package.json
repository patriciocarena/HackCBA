{
  "name": "dante",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test --parallel --timeout 10000",
    "test:watch": "bun test --watch --parallel --timeout 10000",
    "typecheck": "bun --bun ./node_modules/.bin/tsc --noEmit",
    "dev": "bun --bun ./node_modules/.bin/mastra dev",
    "build": "bun --bun ./node_modules/.bin/mastra build",
    "start": "bun --bun ./node_modules/.bin/mastra start",
    "set-webhook": "bun src/telegram/set-webhook.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.66.0",
    "@mastra/libsql": "1.22.5",
    "@mastra/loggers": "1.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "mastra": "1.29.0",
    "typescript": "^6.0.3"
  }
}
